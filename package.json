{
  "name": "elmackflay-video-template",
  "version": "1.0.0",
  "private": true,
  "description": "Plantilla de Remotion para los Reels de Elmackflay",
  "scripts": {
    "studio": "remotion studio",
    "transcribe": "node scripts/transcribe.mjs",
    "captions": "node scripts/whisper-to-captions.mjs",
    "render": "remotion render ElmackflayReel",
    "render:demo": "remotion render ElmackflayReel out/demo.mp4",
    "portada": "remotion still ElmackflayPortada",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "4.0.524",
    "@remotion/cli": "4.0.524",
    "@remotion/fonts": "4.0.524",
    "@remotion/install-whisper-cpp": "4.0.524",
    "@remotion/media-parser": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "@remotion/zod-types": "4.0.524",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.524",
    "simple-icons": "16.33.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
